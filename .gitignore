# Credenciales
.env

# Entorno y caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Artefactos generados
chroma_db/
logs/
data/exports/
data/memory/*.jsonl

# Base de datos interna (stock real y ventas): es estado de operacion, no codigo
data/internal/*.db
data/internal/*.db-wal
data/internal/*.db-shm

# Copia del CSV que usan los evals (se regenera en cada corrida)
data/internal/*_eval.csv

# Evidencia de pruebas (se versiona)
!tests/resultados/

# Corrida por partes (intermedio, se regenera; solo el reporte final se versiona)
tests/resultados/eval_parcial.jsonl