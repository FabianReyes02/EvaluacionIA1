# Credenciales - copia a .env y completa
# OPENAI_API_KEY de https://platform.openai.com/api-keys (sk-..., de pago)
OPENAI_API_KEY=""

# Alternativa: Anthropic (opcional)
# ANTHROPIC_API_KEY=""

# Proveedor LLM activo: "openai" | "anthropic"
LLM_PROVIDER="openai"

# Modelo por defecto
OPENAI_MODEL="gpt-4o-mini"

# Embeddings locales (sin API; primera descarga ~470MB)
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"