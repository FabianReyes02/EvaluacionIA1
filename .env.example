# Credenciales - copia a .env y completa
# OPENAI_API_KEY de https://platform.openai.com/api-keys (sk-..., de pago)
OPENAI_API_KEY=""

# Alternativa: Groq (gratis, clave empieza en gsk_)
GROQ_API_KEY=""

# Alternativa: Anthropic (opcional)
# ANTHROPIC_API_KEY=""

# Proveedor LLM activo: "openai" | "groq" | "anthropic"
LLM_PROVIDER="groq"

# Modelos por defecto
OPENAI_MODEL="gpt-4o-mini"
# Modelos de Groq con tool-calling verificado: qwen/qwen3.8-27b, openai/gpt-oss-20b
# (groq/compound-mini y allam-2-7b NO soportan tool-calling)
GROQ_MODEL="qwen/qwen3.8-27b"

# Embeddings locales (sin API; primera descarga ~470MB)
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Reintentos solo ante limite de tasa 429 (plan gratuito Groq: 1000 OTPM)
AGENT_RETRY_ATTEMPTS="4"
AGENT_RETRY_BASE_S="20"

LANGSMITH_TRACING=true
LANGSMITH_API_KEY="lsv..."
LANGSMITH_PROJECT="EvaluacionIA1"

# ---------------------------------------------------------------------------
# Envio de cotizaciones por correo (tool enviar_cotizacion_email)
# ---------------------------------------------------------------------------
# Modo: "smtp" (envia de verdad, es el default) | "dry" (deja el .eml en
# data/exports/, no envia nada) | "auto" (smtp si hay credenciales, dry si no).
EMAIL_MODE="smtp"

# Servidor SMTP.
#   Gmail real:      smtp.gmail.com / 587 + SMTP_TLS="1"
#   Outlook/M365:   smtp.office365.com / 587 + SMTP_TLS="1"
#   Sandbox Mailtrap: sandbox.smtp.mailtrap.io / 2525 + SMTP_TLS="0" (los correos
#   se quedan atrapados en el panel de Mailtrap y no llegan a nadie real).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Credenciales. En Gmail/Outlook hay que usar una CONTRASENA DE APLICACION
# (Google Account > Security > 2-Step Verification > App passwords), no la
# contrasena normal de la cuenta.
SMTP_USER=""
SMTP_PASSWORD=""

# STARTTLS (puerto 587) o SSL directo (puerto 465)
SMTP_TLS="1"
SMTP_SSL="0"

# Remitente con nombre visible. Si se deja vacio se usa SMTP_USER.
# Tiempo maximo de espera en segundos.
EMAIL_FROM="Repuestos Sur"
EMAIL_TIMEOUT_S="15"

# Lista blanca de dominios permitidos (ej: "gmail.com,ejemplo.com").
# Vacio = sin restriccion.
EMAIL_DOMAINS_ALLOWLIST="gmail.com,ejemplo.com"

# ---------------------------------------------------------------------------
# Base de datos interna de la tienda (stock real y ventas)
# ---------------------------------------------------------------------------
# Ruta del archivo SQLite. Los evals usan una BD aparte para no tocar la de
# operacion.
TIENDA_DB_PATH="data/internal/tienda.db"