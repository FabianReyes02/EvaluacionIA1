# Credenciales - copia a .env y completa
# OPENAI_API_KEY de https://platform.openai.com/api-keys (sk-..., de pago)
OPENAI_API_KEY=""

# Alternativa: Groq (gratis, clave empieza en gsk_)
GROQ_API_KEY=""

# Alternativa: Anthropic (opcional)
# ANTHROPIC_API_KEY=""

# Proveedor LLM activo: "openai" | "groq" | "anthropic"
LLM_PROVIDER="groq"

# Modelos por defecto
OPENAI_MODEL="gpt-4o-mini"
# Modelos de Groq con tool-calling verificado: qwen/qwen3.8-27b, openai/gpt-oss-20b
# (groq/compound-mini y allam-2-7b NO soportan tool-calling)
GROQ_MODEL="qwen/qwen3.8-27b"

# Embeddings locales (sin API; primera descarga ~470MB)
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Reintentos solo ante limite de tasa 429 (plan gratuito Groq: 1000 OTPM)
AGENT_RETRY_ATTEMPTS="4"
AGENT_RETRY_BASE_S="20"

LANGSMITH_TRACING=true
LANGSMITH_API_KEY="lsv..."
LANGSMITH_PROJECT="EvaluacionIA1"

# ---------------------------------------------------------------------------
# Envio de cotizaciones por correo (tool enviar_cotizacion_email)
# ---------------------------------------------------------------------------
# Modo: "smtp" (envia de verdad) | "dry" (deja el .eml en data/exports/, no
# envia nada) | "auto" (smtp si hay credenciales, dry si no). Por defecto el
# agente NUNCA sale a internet sin que se configure esto a mano.
EMAIL_MODE="auto"

# Servidor SMTP (Gmail: smtp.gmail.com / 587, Outlook: smtp.office365.com / 587)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"

# Credenciales. En Gmail/Outlook hay que usar una CONTRASENA DE APLICACION,
# no la contraseña normal de la cuenta.
SMTP_USER=""
SMTP_PASSWORD=""

# STARTTLS (puerto 587) o SSL directo (puerto 465)
SMTP_TLS="1"
SMTP_SSL="0"

# Remitente con nombre visible y tiempo maximo de espera en segundos
EMAIL_FROM="Repuestos Sur <cotizaciones@repuestosur.cl>"
EMAIL_TIMEOUT_S="15"

# Lista blanca de dominios permitidos (ej: "clientesur.cl,repuestosur.cl").
# Vacio = sin restriccion.
EMAIL_DOMAINS_ALLOWLIST=""